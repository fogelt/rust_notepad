# Optional local overrides for development.
#
# Keys stored in the OS keychain (Settings > Provider) take priority. These
# values are only used when the matching key has not been stored in the app.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# Optional model overrides. Leave empty to use the curated default for the
# active provider. Examples:
#   GEMINI_MODEL=gemini-3.8-flash
#   OPENAI_MODEL=gpt-6.1-sol
#   ANTHROPIC_MODEL=claude-sonnet-5-5
#   DEEPSEEK_MODEL=deepseek-chat
GEMINI_MODEL=
OPENAI_MODEL=
ANTHROPIC_MODEL=
DEEPSEEK_MODEL=

# Optional custom OpenAI-compatible endpoint (Ollama, LM Studio, llama.cpp,
# vLLM, or a hosted gateway). The endpoint can be a host, a /v1 base, or the
# full chat-completions URL. The key is optional.
CUSTOM_LLM_ENDPOINT=
CUSTOM_LLM_MODEL=
CUSTOM_LLM_API_KEY=
